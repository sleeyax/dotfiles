# Which ML4W upstream the tree under home/ is based on.
# ML4W_COMMIT is the merge base for 3-way merges when porting a feature — that is its job.
ML4W_REMOTE=https://github.com/mylinuxforwork/dotfiles.git
ML4W_TAG=2.14.1
ML4W_COMMIT=f974938fd39382bc54816dcf5e76983239108914
ML4W_DATE=2026-07-09

# The settings app is a separate repo that apply.sh installs into ~/.local.
# Pinned by commit, not tag: its only tag (0.2.0) predates the CustomTheme/Theme.qml layout the shipped configs expect.
ML4W_SETTINGS_REPO=https://github.com/mylinuxforwork/ml4w-dotfiles-settings.git
ML4W_SETTINGS_COMMIT=2aedacd4ff11a0a831e0721dc16e855ccfb78132
