# Backs the home directory up to the Storage Box; backup.timer starts it on the machine's schedule.
# The guide is docs/backups.md; the rationale is under Backups in AGENTS.md.

[Unit]
Description=Back up the home directory to the Storage Box
ConditionACPower=true
OnFailure=backup-failed.service

[Service]
Type=oneshot
# panda backs up while it is in use, so the run takes CPU and disk time only when nothing else wants them.
Nice=19
IOSchedulingClass=idle
ExecCondition=%h/.config/borgmatic/on-schedule.sh
# Suspend is refused for as long as the run lasts.
# logind ignores inhibitors for the lid switch by default, so closing the lid still suspends.
ExecStart=%h/.config/borgmatic/inhibit-sleep.sh borgmatic --verbosity -2 --syslog-verbosity 1
