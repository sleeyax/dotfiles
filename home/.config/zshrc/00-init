# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# -----------------------------------------------------
# Exports
# -----------------------------------------------------
export EDITOR="code --wait"
export ZSH="$HOME/.oh-my-zsh"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export PATH="$PATH:$HOME/.cargo/bin"

# ssh-agent runs as a systemd user unit, which exports no path of its own, so
# the socket has to be named here. Only when it is actually there: a session
# that reaches this file without the unit running would otherwise be pointed at
# a socket that doesn't exist, and on a machine with no XDG_RUNTIME_DIR at all
# the export expands to a bare /ssh-agent.socket. Either way the cost is the
# same, and it is paid on the VPS rather than the desktops: SSH hands a
# forwarded agent to a remote session in this same variable, and overwriting it
# loses every key for the rest of the session.
if [ -S "$XDG_RUNTIME_DIR/ssh-agent.socket" ]; then
  export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
fi

# -----------------------------------------------------
# Node Version Manager (fnm preferred, nvm fallback)
# -----------------------------------------------------
if command -v fnm &> /dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh)"
elif [ -s ~/.nvm/nvm.sh ]; then
  source ~/.nvm/nvm.sh
  load-nvmrc() {
    local node_version="$(nvm version)"
    local nvmrc_path="$(nvm_find_nvmrc)"

    # If a .nvmrc file is found, use the specified version.
    if [ -n "$nvmrc_path" ]; then
      local nvmrc_node_version=$(cat "${nvmrc_path}")

      # If the version is "system", use the system version.
      if [ "$nvmrc_node_version" = "system" ]; then
        # If we're not already using the system version, switch to it.
        if [ "$node_version" != "$(nvm version system)" ]; then
          nvm use system
        fi
      # If the version differs from the current version, use the version specified in .nvmrc.
      elif [ "$nvmrc_node_version" != "$node_version" ]; then
        nvm use
      fi
    # If no .nvmrc file is found, use the default version.
    elif [ "$node_version" != "$(nvm version default)" ]; then
      nvm use default
    fi
  }
  load-nvmrc
fi

